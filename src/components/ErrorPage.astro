---
import type { HTMLAttributes } from "astro/types";
import Layout from "../layouts/Layout.astro";
import Rebacchi from "./rebacchi/Rebacchi.svelte";

export interface Props extends HTMLAttributes<"div"> {
  statusCode: number;
  title: string;
  message: string;
}

const { statusCode, title, message } = Astro.props;
const heading =
  statusCode === 404 ? "おや、迷子ですか？" : "ちょっと、ひと休み。";
---

<Layout title={`${statusCode} ${title}`}>
  <section class="error-page" aria-labelledby="error-heading">
    <div class="error-card">
      <div class="copy">
        <p class="eyebrow"><span></span> {statusCode} / {title}</p>
        <h1 id="error-heading">{heading}</h1>
        <p class="message">
          {message}<br />ればっちくんと、一緒に戻りましょう。
        </p>
        <a class="home-link" href="/"
          >ホームへ戻る <span aria-hidden="true">↗</span></a
        >
        <p class="aside">寄り道から、はじまることもある。</p>
      </div>
      <div class="exhibit">
        <span class="status-backdrop" aria-hidden="true">{statusCode}</span>
        <Rebacchi client:visible />
      </div>
      <div class="card-footer" aria-hidden="true">
        <span>REVATI STUDIO</span>
        <span
          >創造は、つづく。<svg
            class="footer-spark"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"></path></svg
          ></span
        >
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .error-page {
    display: grid;
    place-items: center;
    min-height: 620px;
    padding: 28px 40px 72px;
    box-sizing: border-box;
  }
  .error-card {
    display: grid;
    grid-template-columns: 0.95fr 1.15fr;
    width: min(1120px, 100%);
    border: 1px solid #a6b7ff24;
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 76% 43%,
        #424ac452 0,
        #22294b21 38%,
        transparent 66%
      ),
      linear-gradient(125deg, #16171e, #101221 68%, #181d37);
    box-shadow: 0 32px 100px #00000030;
  }
  .copy {
    align-self: center;
    padding: 68px 0 62px 56px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #afb7d4;
    font-size: 11px;
    letter-spacing: 0.08em;
    @include font-montserrat;
    span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: $color-accent;
    }
  }
  h1 {
    margin: 28px 0 22px;
    color: #f4f3ff;
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 900;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }
  .message {
    margin: 0;
    color: #b6b7c8;
    font-size: 13px;
    line-height: 2.2;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    margin-top: 34px;
    padding: 15px 22px;
    border: 1px solid #f5f2ff;
    border-radius: 100px;
    background: #f5f2ff;
    color: #1c1b2d;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
    span {
      font-size: 22px;
      line-height: 1;
    }
    &:hover {
      transform: translateY(-2px);
      background: #dfe6ff;
      box-shadow: 0 8px 30px #96a6ff20;
    }
  }
  .aside {
    margin: 28px 0 0;
    color: #898ca4;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .exhibit {
    position: relative;
    min-width: 0;
    min-height: 480px;
    background: radial-gradient(ellipse at 52% 48%, #5867e514, transparent 65%);
  }
  .status-backdrop {
    position: absolute;
    inset: 18px 0 auto;
    color: #a3b1ff09;
    font-size: clamp(130px, 20vw, 255px);
    letter-spacing: -0.07em;
    text-align: center;
    line-height: 1.3;
    pointer-events: none;
    @include font-montserrat(800);
  }
  .card-footer {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 28px;
    padding: 18px 0;
    border-top: 1px solid #afbbff17;
    color: #989db6;
    font-size: 9px;
    letter-spacing: 0.12em;
    @include font-montserrat;
  }
  .footer-spark {
    margin-left: 16px;
    color: #b3c6ff;
    font-size: 16px;
    vertical-align: middle;
  }
  @include sp {
    .error-page {
      min-height: auto;
      padding: 16px 16px 48px;
    }
    .error-card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: 20px;
    }
    .copy {
      grid-row: 2;
      padding: 8px 26px 32px;
      text-align: center;
    }
    .eyebrow {
      justify-content: center;
      font-size: 10px;
    }
    h1 {
      margin: 18px 0 14px;
      font-size: clamp(1.25rem, 5.6vw, 1.75rem);
    }
    .message {
      font-size: 11px;
    }
    .home-link {
      margin-top: 24px;
    }
    .aside {
      margin-top: 20px;
    }
    .exhibit {
      grid-row: 1;
      min-height: 350px;
    }
    .status-backdrop {
      inset: 0 0 auto;
      font-size: clamp(150px, 47vw, 240px);
    }
    .card-footer {
      margin: 0 20px;
      font-size: 8px;
      padding: 14px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-link {
      transition: none;
      &:hover {
        transform: none;
      }
    }
  }
</style>
